# Copy to terraform.tfvars and fill in your own values.

aws_region       = "us-east-1"
ami_id           = "ami-0XXXXXXXXXXXXXXXX"   # look up latest Amazon Linux 2023 AMI for your region
instance_type    = "t2.micro"
ssh_allowed_cidr = "203.0.113.25/32"          # replace with YOUR public IP/32
key_name         = "my-ec2-keypair"
